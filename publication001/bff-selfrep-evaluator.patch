+template <typename Language>
+std::vector<uint8_t> Simulation<Language>::RunSingleParsedProgramState(
+    const std::vector<uint8_t> &parsed, size_t stepcount, bool debug) const {
+  constexpr size_t tape_size = 2 * kSingleTapeSize;
+  std::vector<uint8_t> initial(tape_size, 0);
+  CHECK(parsed.size() <= tape_size);
+  memcpy(initial.data(), parsed.data(), parsed.size());
+
+  DeviceMemory<uint8_t> mem(tape_size);
+  mem.Write(initial.data(), tape_size);
+
+  RUN(1, 1, RunOneProgram<Language>, mem.Get(), stepcount, debug);
+
+  Synchronize();
+  std::vector<uint8_t> final_state(tape_size);
+  mem.Read(final_state.data(), tape_size);
+  return final_state;
+}
+
