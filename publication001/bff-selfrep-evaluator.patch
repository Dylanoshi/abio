                                             size_t stepcount,
@@ -315,6 +334,25 @@ std::vector<uint8_t> Simulation<Language>::Parse(const std::string& program) {
 }
 
 
+template <typename Language>
+std::vector<size_t> Simulation<Language>::EvalPopulationSelfrep(
+    const std::vector<uint8_t> &population, size_t epoch,
+    size_t seed) const {
+  CHECK(population.size() % kSingleTapeSize == 0);
+  size_t num_programs = population.size() / kSingleTapeSize;
+  CHECK(num_programs > 0 && num_programs % 32 == 0);
+  DeviceMemory<uint8_t> mem(population.size());
+  mem.Write(population.data(), population.size());
+  DeviceMemory<size_t> result(num_programs);
+  size_t epoch_seed = SplitMix64(SplitMix64(seed) ^ SplitMix64(epoch));
+  RUN(num_programs / 32, 32, CheckSelfRep<Language>,
+      mem.Get(), epoch_seed, num_programs, result.Get(), false);
+  Synchronize();
+  std::vector<size_t> scores(num_programs);
+  result.Read(scores.data(), num_programs);
+  return scores;
+}
